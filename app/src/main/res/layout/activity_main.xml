<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context=".MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:minHeight="96dp"
            android:padding="16dp"
            android:text="0"
            android:textColor="@color/md_theme_onSurface"
            android:textIsSelectable="true"
            android:textSize="22sp"
            android:typeface="monospace" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="4dp"
        android:text="@string/hint_radians"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardDisplay" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollKeys"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textHint">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/btnAc"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="AC" />

            <Button
                android:id="@+id/btnDel"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="⌫" />

            <Button
                android:id="@+id/btnOpen"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="(" />

            <Button
                android:id="@+id/btnClose"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text=")" />

            <Button
                android:id="@+id/btnDiv"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="÷" />

            <Button
                android:id="@+id/btnSin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="sin" />

            <Button
                android:id="@+id/btnCos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="cos" />

            <Button
                android:id="@+id/btnTan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="tan" />

            <Button
                android:id="@+id/btnLn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="ln" />

            <Button
                android:id="@+id/btnLog10"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="log" />

            <Button
                android:id="@+id/btnSqrt"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="√" />

            <Button
                android:id="@+id/btnPow"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="^" />

            <Button
                android:id="@+id/btnPi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="π" />

            <Button
                android:id="@+id/btnE"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="e" />

            <Button
                android:id="@+id/btnExp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="exp" />

            <Button
                android:id="@+id/btn7"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="7" />

            <Button
                android:id="@+id/btn8"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="8" />

            <Button
                android:id="@+id/btn9"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="9" />

            <Button
                android:id="@+id/btnMul"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="×" />

            <Button
                android:id="@+id/btnAns"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="Ans" />

            <Button
                android:id="@+id/btn4"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="4" />

            <Button
                android:id="@+id/btn5"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="5" />

            <Button
                android:id="@+id/btn6"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="6" />

            <Button
                android:id="@+id/btnSub"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="−" />

            <Button
                android:id="@+id/btnDegRad"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="Rad" />

            <Button
                android:id="@+id/btn1"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="1" />

            <Button
                android:id="@+id/btn2"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="2" />

            <Button
                android:id="@+id/btn3"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="3" />

            <Button
                android:id="@+id/btnAdd"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="+" />

            <Button
                android:id="@+id/btnAsin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="asin" />

            <Button
                android:id="@+id/btnAcos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="acos" />

            <Button
                android:id="@+id/btn0"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="0" />

            <Button
                android:id="@+id/btnDot"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="." />

            <Button
                android:id="@+id/btnEq"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="=" />
        </GridLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
