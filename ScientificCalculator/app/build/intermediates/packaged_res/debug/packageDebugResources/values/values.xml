<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF121212</color>
    <color name="display_bg">#FF1E1E1E</color>
    <color name="key_accent">#FFFF6D00</color>
    <color name="key_digit">#FF2D2D2D</color>
    <color name="key_func">#FF424242</color>
    <color name="key_op">#FF3D5AFE</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Научный калькулятор</string>
    <string name="error_invalid">Ошибка выражения</string>
    <style name="CalcButtonBase" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="CalcButtonDigit" parent="CalcButtonBase">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/key_digit</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="CalcButtonEquals" parent="CalcButtonBase">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/key_accent</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="CalcButtonFunc" parent="CalcButtonBase">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/key_func</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="CalcButtonOp" parent="CalcButtonBase">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/key_op</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:weightSum">5</item>
    </style>
    <style name="Theme.ScientificCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>